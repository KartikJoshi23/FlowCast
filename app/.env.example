# Copy to app/.env for local runs with `netlify dev` / `netlify serve` (never commit .env).
# In production set these in Netlify: Project configuration -> Environment variables,
# with ANTHROPIC_API_KEY marked "Contains secret values" and scoped to Functions.

ANTHROPIC_API_KEY=
# Optional overrides
LLM_MODEL=claude-opus-5-5
LLM_DAILY_CAP=200
LLM_PER_MINUTE=6
