# Copy to app/.env for local runs with `netlify serve` (never commit .env).
# In production set these in Netlify: Project configuration -> Environment variables,
# marked "Contains secret values" and scoped to Functions.

# Free option (recommended): a key from https://build.nvidia.com (starts with "nvapi-").
NVIDIA_API_KEY=
# Paid alternative, used only when NVIDIA_API_KEY is empty.
ANTHROPIC_API_KEY=

# Optional overrides
# LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_DAILY_CAP=200
LLM_PER_MINUTE=6
