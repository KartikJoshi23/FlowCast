{
  "name": "flavored-water-forecast",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive demand-forecasting dashboard for a new flavored-water product (AI in Operations lab).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "node node_modules/vitest/vitest.mjs run",
    "parity": "node scripts/pyodide-parity.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@netlify/blobs": "11.1.7",
    "echarts": "6.1.0",
    "motion": "14.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pyodide": "314.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
